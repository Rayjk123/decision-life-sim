{
  "name": "decision-life-sim",
  "private": true,
  "version": "0.1.0",
  "description": "A pixel life-sim where every sim's financial decisions come from a decision model (Kev).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sim": "tsx packages/worker/src/cli.ts",
    "kev:check": "tsx packages/worker/src/kevCheck.ts",
    "test": "node --import tsx --test packages/*/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx packages/evals/src/run.ts",
    "experiment": "tsx packages/worker/src/experiment.ts",
    "dashboard": "node packages/dashboard/serve.mjs",
    "eval:permute": "tsx packages/evals/src/permute.ts",
    "docs:results": "tsx scripts/results-page.ts",
    "verify": "tsx scripts/verify.ts",
    "health": "tsx scripts/health.ts",
    "eval:compare": "tsx packages/evals/src/compare.ts",
    "eval:fingerprint": "tsx packages/evals/src/fingerprint.ts",
    "ux": "tsx scripts/ux-smoke.ts",
    "town:smoke": "tsx scripts/town-ux-smoke.ts",
    "town:soak": "tsx scripts/town-soak.ts",
    "town": "tsx packages/town/src/server.ts",
    "probe": "tsx packages/worker/src/probeCli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright-core": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
